<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Verso Launcher</string>
    <string name="hint_search">&gt; search</string>
    <string name="clear_prompt">Clear prompt</string>
    <!-- Home page (the front of the page; the drawer is its back). -->
    <string name="home_hint">Swipe up for all apps, down for recent ones.\n\nTo put apps here, type ! in the drawer\'s search line and tap them. !! reorders them.</string>
    <string name="a11y_home">Home screen</string>
    <string name="a11y_open_drawer">Open all apps</string>
    <!-- A dimmed app (AppStatus): what a screen reader says, and the toast once a paused one is back. -->
    <string name="a11y_app_paused">%1$s, paused. Double-tap to turn its work apps back on.</string>
    <string name="a11y_app_archived">%1$s, archived. Double-tap to restore it.</string>
    <string name="toast_app_ready">%1$s is ready — tap to open it</string>
    <!-- The double-tap targets on home: what TalkBack announces for activating them. -->
    <string name="a11y_open_alarms">open alarms</string>
    <string name="a11y_open_calendar">open calendar</string>
    <string name="a11y_open_battery">open battery usage</string>
    <!-- What a screen reader says for the battery text; %1$s is its percentage label. -->
    <string name="a11y_battery">battery %1$s</string>
    <string name="a11y_charging">Charging</string>
    <string name="a11y_battery_protected">Battery protection: charge is being held</string>
    <string name="toast_no_app">no app for that on this device</string>
    <string name="hint_rename_name">Name</string>
    <string name="hint_rename_tags">Tags (comma-separated)</string>
    <!-- Neutral button in the long-press dialog: opens the system App info screen. -->
    <string name="action_app_info">App info</string>
    <string name="toast_not_found">not found: %1$s</string>
    <string name="toast_denied">denied: %1$s</string>
    <!-- One-shot "~" commands. %1$s in toast_backup_ok is the written file name; in
         toast_restore_ok the time (HH:mm) in the undo point's name. -->
    <string name="toast_saved">config saved</string>
    <string name="toast_not_loaded">config not loaded yet — try again in a moment</string>
    <string name="toast_not_default_home">set Verso as default home app to turn work apps on</string>
    <string name="toast_reloaded">config reloaded</string>
    <string name="toast_save_failed">save failed — nothing written</string>
    <string name="toast_backup_ok">backup: Download/Verso/%1$s</string>
    <string name="toast_backup_failed">backup failed — nothing written</string>
    <string name="toast_restore_ok">restored — to undo: ~restore-saf, pick verso-pre-restore (%1$s)</string>
    <string name="toast_restore_same">nothing to restore — that config is already in use</string>
    <string name="toast_restore_list_failed">Download/Verso unreadable — try ~restore-saf</string>
    <string name="toast_restore_undo_failed">nothing changed — could not save the current config</string>
    <string name="toast_restore_write_failed">nothing changed — could not write the restored config</string>
    <string name="toast_restore_failed">nothing changed — not a readable config file</string>
    <string name="toast_restore_none">no backup — run ~backup, or pick one: ~restore-saf</string>
    <string name="toast_cleanup_none">nothing to clean up</string>
    <string name="toast_cleanup_incomplete">not every profile could be read — try again later</string>
    <!-- %1$s: the time (HH:mm) in the undo point's name. -->
    <string name="toast_cleanup_ok">cleaned up (undo point %1$s) — undo: ~restore-saf</string>
    <string name="cleanup_title">Clean up</string>
    <string name="cleanup_remove">Remove</string>
    <!-- The cleanup dialog's lines; a section with nothing to remove is left out. -->
    <string name="cleanup_apps">Apps no longer installed: %1$d</string>
    <string name="cleanup_favorites">favorites: %1$d</string>
    <string name="cleanup_hidden">hidden: %1$d</string>
    <string name="cleanup_names">custom names: %1$d</string>
    <string name="cleanup_tags">tag lists: %1$d</string>
    <string name="cleanup_undo_note">The current config is saved first (verso-pre-cleanup).</string>
    <string name="toast_cleanup_not_run">nothing changed — try again</string>
    <string name="toast_cleanup_superseded">nothing changed — the config was replaced meanwhile</string>
    <string name="toast_restore_no_picker">no file picker on this device</string>
    <!-- A "~" command runs behind a busy layer, one at a time (CommandGate). -->
    <string name="toast_busy">busy — wait for the running command</string>
    <string name="toast_command_failed">nothing changed — try again</string>
    <string name="toast_command_error">unexpected error — the command did not report back</string>
    <!-- Back during the "~restore-saf" read, the only step that can be abandoned. -->
    <string name="toast_command_cancelled">cancelled — nothing changed</string>
    <string name="a11y_busy">Working…</string>
    <!-- Under the wheel once a command runs unusually long, and the toast when Back is used then. -->
    <string name="busy_escape_hint">still working — Back gives you the launcher meanwhile</string>
    <!-- The same moment while the file picked for ~restore-saf is still being read: Back cancels. -->
    <string name="busy_cancel_hint">still reading the picked file — Back cancels, nothing changes</string>
    <string name="toast_busy_waived">still running — new commands wait until it is done</string>
    <!-- verso.json is there but cannot be read (ConfigStore.load): the config counts as not
         loaded — edits and saves are off, nothing of the empty default reaches the disk. -->
    <string name="toast_config_unreadable">config unreadable — edits are off until it can be read (retried on every return). ~load tries now, ~restore brings back a backup, ~reset starts over</string>
    <string name="toast_reload_unreadable">config unreadable — nothing loaded, nothing changed</string>
    <string name="toast_reload_changed">not loaded — the config was changed meanwhile</string>
    <string name="toast_backup_unreadable">config unreadable — no backup written, the old one is kept</string>
    <!-- %1$s: the names the unreadable files were renamed to (verso.json.unreadable, …). -->
    <string name="toast_restore_replaced">restored — copy of the old one in Download/Verso</string>
    <string name="toast_restore_replaced_private">restored — the old one is set aside as %1$s</string>
    <string name="toast_restore_unsaved">restored, but not saved — ~save tries again</string>
    <!-- "~reset": only while the config is unreadable; the files are renamed, never deleted. -->
    <string name="reset_title">Reset config</string>
    <string name="reset_message">verso.json cannot be read. Reset sets the unreadable files aside — renamed to …unreadable, not deleted, with a copy in Download/Verso — and starts over like a fresh install: no names, no tags, nothing hidden, the default favorites.</string>
    <string name="reset_backup_note">A backup exists: ~restore brings your config back instead. If you reset anyway, do not run ~backup before your config is back — it would replace that backup with the fresh one.</string>
    <string name="reset_backup_unknown">The backup folder could not be checked, so a backup may exist: if so, ~restore brings your config back instead. If you reset anyway, do not run ~backup before your config is back — it would replace that backup with the fresh one.</string>
    <string name="reset_confirm">Reset</string>
    <!-- %1$s: the names the unreadable files were renamed to. -->
    <string name="toast_reset_done">reset — copy in Download/Verso (verso-unreadable-…)</string>
    <string name="toast_reset_done_private">reset — set aside as %1$s</string>
    <string name="toast_reset_readable">config is readable — nothing to reset</string>
    <string name="toast_reset_readable_now">config readable again — loading it, nothing reset</string>
    <string name="toast_reset_failed">nothing changed — the unreadable config could not be set aside</string>
    <!-- Spoken row descriptions for the edit modes (the "[x]"/"[ ]" glyph is not
         read aloud sensibly). %1$s is the app label. -->
    <string name="a11y_hidden_on">Hidden: %1$s. Double-tap to unhide.</string>
    <string name="a11y_hidden_off">Visible: %1$s. Double-tap to hide.</string>
    <string name="a11y_fav_on">Favorite: %1$s. Double-tap to remove.</string>
    <string name="a11y_fav_off">Not a favorite: %1$s. Double-tap to add.</string>
    <!-- Bulk tag editing ("##tag"). %1$s is the app label, %2$s the tag. -->
    <string name="a11y_tag_on">Tagged %2$s: %1$s. Double-tap to remove the tag.</string>
    <string name="a11y_tag_off">Not tagged %2$s: %1$s. Double-tap to add the tag.</string>
    <!-- Reorder-favorites mode (the "»" grab marker doesn't read aloud sensibly). -->
    <string name="a11y_reorder_pick">%1$s. Double-tap to pick up for reordering.</string>
    <string name="a11y_reorder_picked">Picked up: %1$s. Double-tap to cancel.</string>
    <string name="a11y_reorder_drop">%1$s. Double-tap to move the picked favorite here.</string>

    <!-- What an empty drawer list says (LauncherLogic.emptyHint). -->
    <string name="empty_no_match">no app matches</string>
    <string name="empty_no_apps">no apps</string>
    <string name="empty_no_tags">no tags yet — create one with ##name</string>
    <string name="empty_no_tag_match">no tag starts like that</string>
    <string name="empty_no_favorites">no favorites yet — add some with !</string>
    <string name="empty_no_recents">no recent apps yet — the list resets on restart</string>
    <string name="empty_no_command">no such command — ~ lists them all</string>
</resources>
