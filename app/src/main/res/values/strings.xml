<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Verso Launcher</string>
    <string name="hint_search">&gt; search</string>
    <string name="clear_prompt">Clear prompt</string>
    <!-- Home page (the front of the page; the drawer is its back). -->
    <string name="home_hint">Swipe up for all apps, down for recent ones.\n\nTo put apps here, type ! in the drawer\'s search line and tap them. !! reorders them.</string>
    <string name="a11y_home">Home screen</string>
    <string name="a11y_open_drawer">Open all apps</string>
    <string name="a11y_open_recents">Open recent apps</string>
    <!-- Pane titles: what TalkBack announces when a page turns up. -->
    <string name="a11y_pane_drawer">All apps</string>
    <string name="a11y_pane_recents">Recent apps</string>
    <!-- The command line's hint as a screen reader speaks it (the visible one starts with ">"). -->
    <string name="a11y_prompt_hint">Search all apps</string>
    <!-- A paused app back again (AppStatus). -->
    <string name="toast_app_ready">%1$s is ready — tap to open it</string>
    <!-- The double-tap targets on home: what TalkBack announces for activating them. -->
    <string name="a11y_open_alarms">open alarms</string>
    <string name="a11y_open_calendar">open calendar</string>
    <string name="a11y_open_battery">open battery usage</string>
    <!-- What a screen reader says for the battery text; %1$s is its percentage label. -->
    <string name="a11y_battery">battery %1$s</string>
    <!-- The charge state, read with the battery line (its icons are no stops of their own). -->
    <string name="a11y_battery_charging">battery %1$s, charging</string>
    <string name="a11y_battery_protected">battery %1$s, battery protection: charge is being held</string>
    <string name="toast_no_app">no app for that on this device</string>
    <string name="hint_rename_name">Name</string>
    <string name="hint_rename_tags">Tags (comma-separated)</string>
    <!-- Neutral button in the long-press dialog: opens the system App info screen. -->
    <string name="action_app_info">App info</string>
    <string name="toast_not_found">not found: %1$s</string>
    <string name="toast_denied">denied: %1$s</string>
    <!-- One-shot "~" commands. %1$s in toast_backup_ok is the written file name; in
         toast_restore_ok the time (HH:mm) in the undo point's name. -->
    <string name="toast_busy">busy — wait for the running command</string>
    <string name="toast_save_failed">not saved</string>
    <!-- verso.json was there but could not be read: Verso started empty, and the next change writes over it. -->
    <string name="toast_config_unreadable">config unreadable, started empty — ~restart first, else ~restore</string>
    <string name="toast_restore_write_failed">restore not saved — nothing restored</string>
    <string name="toast_not_loaded">config not loaded yet — try again in a moment</string>
    <string name="toast_not_default_home">make Verso the default home to turn work apps on</string>
    <string name="toast_backup_ok">backup: Download/Verso/%1$s</string>
    <string name="toast_backup_failed">backup failed — nothing written</string>
    <string name="toast_restore_ok">restored (undo point %1$s) — ~undo takes it back</string>
    <string name="toast_restore_same">nothing to restore — that config is already in use</string>
    <string name="toast_restore_list_failed">Download/Verso unreadable — try ~restore-saf</string>
    <string name="toast_restore_undo_failed">nothing changed — could not save the current config</string>
    <string name="toast_restore_failed">nothing changed — not a readable config file</string>
    <string name="toast_restore_saf_dropped">~restore-saf dropped — the picked file was not restored yet</string>
    <string name="toast_restore_pending">a picked file is still being restored — wait, or ~restart drops it</string>
    <string name="toast_restore_none">no backup — run ~backup, or pick one: ~restore-saf</string>
    <!-- ~undo: the newest undo point of a ~restore, ~cleanup or ~undo. %1$s in toast_undo_ok is the
         time (HH:mm) in the name of the undo point it left itself. -->
    <string name="toast_undo_ok">undone (undo point %1$s) — ~undo again redoes it</string>
    <string name="toast_undo_same">nothing to undo — the last undo point is in use</string>
    <string name="toast_undo_none">nothing to undo — no undo point in Download/Verso</string>
    <string name="toast_cleanup_none">nothing to clean up</string>
    <string name="toast_cleanup_incomplete">not every profile could be read — try again later</string>
    <!-- %1$s: the time (HH:mm) in the undo point's name. -->
    <string name="toast_cleanup_ok">cleaned up (undo point %1$s) — ~undo takes it back</string>
    <string name="cleanup_title">Clean up</string>
    <string name="cleanup_remove">Remove</string>
    <!-- The cleanup dialog's lines; a section with nothing to remove is left out. -->
    <string name="cleanup_apps">Apps no longer installed: %1$d</string>
    <string name="cleanup_favorites">favorites: %1$d</string>
    <string name="cleanup_hidden">hidden: %1$d</string>
    <string name="cleanup_names">custom names: %1$d</string>
    <string name="cleanup_tags">tag lists: %1$d</string>
    <string name="cleanup_undo_note">The current config is saved first (verso-pre-cleanup): ~undo takes it back.</string>
    <!-- The ~restore-saf confirmation: the counts below the intro reuse the cleanup_* labels. -->
    <string name="restore_title">Restore this file?</string>
    <string name="restore_apply">Restore</string>
    <string name="restore_intro">It replaces the whole config with:</string>
    <string name="restore_undo_note">The current config is saved first (verso-pre-restore): ~undo takes it back.</string>
    <string name="toast_cleanup_not_run">nothing changed — try again</string>
    <string name="toast_restore_no_picker">no file picker on this device</string>
    <!-- A row or favorite as a screen reader takes it: the app's name, its state beside it
         (stateDescription), and what a double-tap does (the click's label; TalkBack adds
         "double-tap to"). %1$s in the tag ones is the tag. -->
    <string name="a11y_state_hidden">hidden</string>
    <string name="a11y_state_visible">visible</string>
    <string name="a11y_state_favorite">favorite</string>
    <string name="a11y_state_not_favorite">not a favorite</string>
    <string name="a11y_state_tagged">tagged %1$s</string>
    <string name="a11y_state_not_tagged">not tagged %1$s</string>
    <string name="a11y_state_picked_up">picked up</string>
    <string name="a11y_state_paused">paused</string>
    <string name="a11y_state_archived">archived</string>
    <string name="a11y_do_unhide">unhide</string>
    <string name="a11y_do_hide">hide</string>
    <string name="a11y_do_favorite">add to favorites</string>
    <string name="a11y_do_unfavorite">remove from favorites</string>
    <string name="a11y_do_tag">add the tag</string>
    <string name="a11y_do_untag">remove the tag</string>
    <string name="a11y_do_pick_up">pick up to reorder</string>
    <string name="a11y_do_put_back">put back</string>
    <string name="a11y_do_move_here">move the picked favorite here</string>
    <string name="a11y_do_turn_on_work">turn work apps back on</string>
    <string name="a11y_do_unarchive">restore the app</string>

    <!-- What an empty drawer list says (LauncherLogic.emptyHint). -->
    <string name="empty_no_match">no app matches</string>
    <string name="empty_no_apps">no apps</string>
    <string name="empty_no_tags">no tags yet — create one with ##name</string>
    <string name="empty_no_tag_match">no tag or package starts like that</string>
    <string name="empty_no_favorites">no favorites yet — add some with !</string>
    <string name="empty_no_recents">no recent apps yet</string>
    <string name="empty_no_command">no such command — ~ lists them all</string>
    <string name="order_to_usage" formatted="false">% sort by usage</string>
    <string name="order_to_name" formatted="false">% sort A to Z</string>
    <string name="toast_order_usage">Drawer: most used first</string>
    <string name="toast_order_name">Drawer: A to Z</string>
    <!-- Guru, the crash alert after a crash (guru/, GuruTexts). The Amiga lines themselves stay
         English; these are the host's words around them. -->
    <string name="guru_hint">double-tap: close · hold: share</string>
    <string name="guru_action_close">close</string>
    <string name="guru_action_share">share the report</string>
    <plurals name="guru_saved">
        <item quantity="one">saved to Download/Guru</item>
        <item quantity="other">%d reports saved to Download/Guru</item>
    </plurals>
</resources>
