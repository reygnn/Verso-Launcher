<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme, no AppCompat. The window shows the system
         wallpaper behind it, unobstructed — the root view carries no background
         (an earlier scrim over the wallpaper surface flickered). -->
    <style name="VersoTheme" parent="@android:style/Theme.Material.NoActionBar">
        <!-- windowShowWallpaper makes this window a wallpaper surface: the live
             system wallpaper is drawn behind it, no WallpaperManager needed. The
             window background MUST be transparent for the wallpaper to show
             through. statusBarColor / navigationBarColor are deprecated no-ops
             under the enforced edge-to-edge on SDK 36, so omitted. -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- The busy layer over a running "~" command (MainActivity.showBusy): a full-window,
         see-through dialog. A Material parent, not the old Theme.Translucent.NoTitleBar:
         that Holo-era theme does not draw the system bar backgrounds, and the status bar
         flashed black as the layer came and went. -->
    <style name="VersoBusyLayer" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
