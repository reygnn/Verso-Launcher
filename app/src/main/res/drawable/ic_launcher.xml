<?xml version="1.0" encoding="utf-8"?>
<!-- A page with its corner turned: the front of the page is the home screen, the back
     (verso) is the drawer. White lines on near-black, one platform VectorDrawable — no
     adaptive-icon layers, no density-bucketed PNGs. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#0B0B0B"
        android:pathData="M0,0 h108 v108 h-108 z" />

    <!-- the page outline, top-right corner cut for the fold -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M32,26 L62,26 L78,42 L78,82 L32,82 Z" />

    <!-- the turned-down corner -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M62,26 L62,42 L78,42" />

    <!-- three lines of text -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M42,54 L68,54 M42,64 L68,64 M42,74 L58,74" />
</vector>
