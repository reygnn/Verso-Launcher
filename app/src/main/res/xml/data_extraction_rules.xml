<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup stays off: allowBackup="false" says so, and every domain is excluded here
     too, so it holds whichever of the two the platform reads. A device-to-device transfer moves verso.json
     (the config, and a verso.json.bak a cut-off write left, which the next load takes back) but
     not a stray verso.json.new or verso.json.unreadable,
     nor the home-cache, which is rebuilt on the first load, nor guru/ (Guru's crash reports):
     an old device's reports would be saved to the new one's Download/Guru, its installation-id
     would make the two one installation on the crash server, and exits-seen/crashes-saved
     are the old device's times. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="verso.json.new" />
        <exclude domain="file" path="verso.json.unreadable" />
        <exclude domain="file" path="home-cache.txt" />
        <exclude domain="file" path="home-cache.txt.tmp" />
        <exclude domain="file" path="guru/" />
    </device-transfer>
</data-extraction-rules>
