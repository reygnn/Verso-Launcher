<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup stays off: allowBackup="false" says so, and every domain is excluded here
     too, so it holds whichever of the two the platform reads. The config is the user's own file,
     wherever they keep it; to the cloud it goes the way they put it there. A device-to-device
     transfer moves the app's own files: the link to that file (useless on the new device, whose
     grant does not move: its first read fails, says so, and "~open" links it again), the copy of
     its last text, which shows meanwhile, order.txt, usage.txt and recents.txt. Not a stray temp
     file of a cut-off write, nor the home-cache, which is rebuilt on the first load, nor guru/
     (Guru's crash reports): an old device's reports would be saved to the new one's Download/Guru,
     its installation-id would make the two one installation on the crash server, and
     exits-seen/crashes-saved are the old device's times. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="config-link.txt.tmp" />
        <exclude domain="file" path="config-cache.txt.tmp" />
        <exclude domain="file" path="order.txt.tmp" />
        <exclude domain="file" path="usage.txt.tmp" />
        <exclude domain="file" path="recents.txt.tmp" />
        <exclude domain="file" path="home-cache.txt" />
        <exclude domain="file" path="home-cache.txt.tmp" />
        <exclude domain="file" path="guru/" />
    </device-transfer>
</data-extraction-rules>
