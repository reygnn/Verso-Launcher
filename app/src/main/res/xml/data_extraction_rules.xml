<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup stays off: allowBackup="false" says so, and every domain is excluded here
     too, so it holds whichever of the two the platform reads. A device-to-device transfer moves verso.json
     (the config) but not a half-written verso.json.new, nor an unreadable config set aside,
     nor the home-cache, which is rebuilt on the first load. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="verso.json.new" />
        <exclude domain="file" path="verso.json.unreadable" />
        <exclude domain="file" path="home-cache.txt" />
        <exclude domain="file" path="home-cache.txt.tmp" />
    </device-transfer>
</data-extraction-rules>
