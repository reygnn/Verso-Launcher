<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup stays off: allowBackup="false" says so, and every domain is excluded here
     too, so it holds whichever of the two the platform reads. A device-to-device transfer moves
     the app's own files: order.txt, usage.txt and recents.txt. The user's config file (config.txt
     in the external domain, ConfigFile) is not excluded either. Not a stray temp file
     of a cut-off write, nor the home-cache, which is rebuilt on the first load. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="order.txt.tmp" />
        <exclude domain="file" path="usage.txt.tmp" />
        <exclude domain="file" path="recents.txt.tmp" />
        <exclude domain="file" path="home-cache.txt" />
        <exclude domain="file" path="home-cache.txt.tmp" />
    </device-transfer>
</data-extraction-rules>
