<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- app_name ist "Verso Launcher" (Marke) — kein -de-Override, fällt auf default zurück. -->
    <string name="hint_search">&gt; suche</string>
    <string name="clear_prompt">Eingabe löschen</string>
    <!-- Startseite (Vorderseite; der Drawer ist die Rückseite). -->
    <string name="home_hint">Nach oben wischen für alle Apps, nach unten für die zuletzt genutzten.\n\nFür Favoriten hier: in der App-Liste ! ins Suchfeld tippen und Apps antippen. !! sortiert sie.</string>
    <string name="a11y_home">Startbildschirm</string>
    <string name="a11y_open_drawer">Alle Apps öffnen</string>
    <!-- Eine abgedunkelte App (AppStatus): was der Screenreader sagt, und der Toast, sobald eine pausierte wieder da ist. -->
    <string name="a11y_app_paused">%1$s, pausiert. Doppeltippen, um die Arbeits-Apps wieder einzuschalten.</string>
    <string name="a11y_app_archived">%1$s, archiviert. Doppeltippen zum Wiederherstellen.</string>
    <string name="toast_app_ready">%1$s ist bereit — zum Starten antippen</string>
    <!-- Die Doppeltipp-Ziele auf Home: was TalkBack beim Aktivieren ansagt. -->
    <string name="a11y_open_alarms">Wecker öffnen</string>
    <string name="a11y_open_calendar">Kalender öffnen</string>
    <string name="a11y_open_battery">Akkuverbrauch öffnen</string>
    <string name="a11y_battery">Akku %1$s</string>
    <string name="a11y_charging">Lädt</string>
    <string name="a11y_battery_protected">Akkuschutz: Ladung wird gehalten</string>
    <string name="toast_no_app">Keine passende App auf diesem Gerät</string>
    <string name="hint_rename_name">Name</string>
    <string name="hint_rename_tags">Tags (kommagetrennt)</string>
    <!-- Neutraler Button im Long-Press-Dialog: öffnet die System-App-Info. -->
    <string name="action_app_info">App-Info</string>
    <string name="toast_not_found">Nicht gefunden: %1$s</string>
    <string name="toast_denied">Verweigert: %1$s</string>
    <!-- Einmal-Befehle mit "~". %1$s in toast_backup_ok ist der Dateiname, in
         toast_restore_ok die Uhrzeit (HH:mm) im Namen des Rücksprungpunkts. -->
    <string name="toast_saved">Konfiguration gespeichert</string>
    <string name="toast_not_loaded">Konfiguration noch nicht geladen — gleich nochmal versuchen</string>
    <string name="toast_not_default_home">Verso als Standard-Startbildschirm festlegen, um Arbeits-Apps einzuschalten</string>
    <string name="toast_reloaded">Konfiguration neu geladen</string>
    <string name="toast_save_failed">Speichern fehlgeschlagen — nichts geschrieben</string>
    <string name="toast_backup_ok">Backup: Download/Verso/%1$s</string>
    <string name="toast_backup_failed">Backup fehlgeschlagen — nichts geschrieben</string>
    <string name="toast_restore_ok">Wiederhergestellt — rückgängig: ~restore-saf, verso-pre-restore wählen (%1$s)</string>
    <string name="toast_restore_same">Nichts zu tun — diese Konfiguration ist schon aktiv</string>
    <string name="toast_restore_list_failed">Download/Verso nicht lesbar — ~restore-saf versuchen</string>
    <string name="toast_restore_undo_failed">Nichts geändert — aktuelle Konfiguration nicht sicherbar</string>
    <string name="toast_restore_write_failed">Nichts geändert — wiederhergestellte Konfiguration nicht schreibbar</string>
    <string name="toast_restore_failed">Nichts geändert — keine lesbare Konfiguration</string>
    <string name="toast_restore_none">Kein Backup — erst ~backup, oder Datei wählen: ~restore-saf</string>
    <string name="toast_cleanup_none">Nichts aufzuräumen</string>
    <string name="toast_cleanup_incomplete">Nicht alle Profile lesbar — später nochmal versuchen</string>
    <!-- %1$s: die Uhrzeit (HH:mm) im Namen des Rücksprungpunkts. -->
    <string name="toast_cleanup_ok">Aufgeräumt (Rücksprungpunkt %1$s) — rückgängig: ~restore-saf</string>
    <string name="cleanup_title">Aufräumen</string>
    <string name="cleanup_remove">Entfernen</string>
    <!-- Die Zeilen des Aufräum-Dialogs; ein Abschnitt ohne Einträge fällt weg. -->
    <string name="cleanup_apps">Nicht mehr installierte Apps: %1$d</string>
    <string name="cleanup_favorites">Favoriten: %1$d</string>
    <string name="cleanup_hidden">Ausgeblendet: %1$d</string>
    <string name="cleanup_names">Eigene Namen: %1$d</string>
    <string name="cleanup_tags">Tag-Listen: %1$d</string>
    <string name="cleanup_undo_note">Vorher wird die aktuelle Konfiguration gesichert (verso-pre-cleanup).</string>
    <string name="toast_cleanup_not_run">Nichts geändert — bitte nochmal versuchen</string>
    <string name="toast_cleanup_superseded">Nichts geändert — Konfiguration wurde inzwischen ersetzt</string>
    <string name="toast_restore_no_picker">Keine Dateiauswahl auf diesem Gerät</string>
    <!-- Ein "~"-Befehl läuft hinter einer Sperrebene, einer nach dem anderen (CommandGate). -->
    <string name="toast_busy">Beschäftigt — laufenden Befehl abwarten</string>
    <string name="toast_command_failed">Nichts geändert — bitte nochmal versuchen</string>
    <string name="toast_command_error">Unerwarteter Fehler — der Befehl hat kein Ergebnis gemeldet</string>
    <!-- Zurück während des "~restore-saf"-Lesens, des einzigen abbrechbaren Schritts. -->
    <string name="toast_command_cancelled">Abgebrochen — nichts geändert</string>
    <string name="a11y_busy">Wird ausgeführt…</string>
    <!-- Unter dem Rad, wenn ein Befehl ungewöhnlich lange läuft, und der Toast, wenn dann Zurück gedrückt wird. -->
    <string name="busy_escape_hint">Läuft noch — Zurück gibt den Launcher währenddessen frei</string>
    <!-- Derselbe Moment, solange die für ~restore-saf gewählte Datei noch gelesen wird: Zurück bricht ab. -->
    <string name="busy_cancel_hint">Datei wird noch gelesen — Zurück bricht ab, nichts ändert sich</string>
    <string name="toast_busy_waived">Läuft weiter — andere Befehle erst, wenn er fertig ist</string>
    <!-- verso.json ist da, aber nicht lesbar (ConfigStore.load): die Konfiguration gilt als nicht
         geladen — Bearbeiten und Speichern sind aus, nichts vom leeren Standard landet auf der Platte. -->
    <string name="toast_config_unreadable">Konfiguration unlesbar — Bearbeiten aus. ~load, ~restore oder ~reset</string>
    <string name="toast_reload_unreadable">Konfiguration unlesbar — nichts geladen, nichts geändert</string>
    <string name="toast_reload_changed">Nicht geladen — die Konfiguration wurde inzwischen geändert</string>
    <string name="toast_backup_unreadable">Konfiguration unlesbar — kein Backup geschrieben, das alte bleibt</string>
    <string name="toast_restore_replaced">Wiederhergestellt — Kopie der alten in Download/Verso</string>
    <!-- %1$s: der Name, unter dem die unlesbare Hauptdatei beiseitegelegt wurde (verso.json.unreadable, …). -->
    <string name="toast_restore_replaced_private">Wiederhergestellt — die alte liegt als %1$s beiseite</string>
    <string name="toast_restore_unsaved">Wiederhergestellt, aber nicht gespeichert — ~save versucht es erneut</string>
    <!-- "~reset": nur bei unlesbarer Konfiguration; die Dateien werden umbenannt, nie gelöscht. -->
    <string name="reset_title">Konfiguration zurücksetzen</string>
    <string name="reset_message">verso.json ist nicht lesbar. Zurücksetzen legt die unlesbaren Dateien beiseite — umbenannt in …unreadable, nicht gelöscht, mit einer Kopie in Download/Verso — und beginnt neu wie nach einer Neuinstallation: keine Namen, keine Tags, nichts ausgeblendet, die Standard-Favoriten.</string>
    <string name="reset_backup_note">Es gibt ein Backup: ~restore holt die Konfiguration stattdessen zurück. Nach einem Zurücksetzen kein ~backup, bevor sie wieder da ist — es würde das Backup durch die frische Konfiguration ersetzen.</string>
    <string name="reset_backup_unknown">Der Backup-Ordner ließ sich nicht prüfen, es kann also ein Backup geben: dann holt ~restore die Konfiguration stattdessen zurück. Nach einem Zurücksetzen kein ~backup, bevor sie wieder da ist — es würde das Backup durch die frische Konfiguration ersetzen.</string>
    <string name="reset_confirm">Zurücksetzen</string>
    <string name="toast_reset_done">Zurückgesetzt — Kopie in Download/Verso (verso-unreadable-…)</string>
    <!-- %1$s: der Name, unter dem die unlesbare Hauptdatei beiseitegelegt wurde. -->
    <string name="toast_reset_done_private">Zurückgesetzt — beiseitegelegt als %1$s</string>
    <string name="toast_reset_readable">Konfiguration ist lesbar — nichts zurückzusetzen</string>
    <string name="toast_reset_readable_now">Konfiguration wieder lesbar — wird geladen, nichts zurückgesetzt</string>
    <string name="toast_reset_failed">Nichts geändert — unlesbare Konfiguration nicht beiseitelegbar</string>
    <!-- Gesprochene Zeilenbeschreibung für die Bearbeitungsmodi. %1$s = App-Name. -->
    <string name="a11y_hidden_on">Ausgeblendet: %1$s. Zum Einblenden doppeltippen.</string>
    <string name="a11y_hidden_off">Sichtbar: %1$s. Zum Ausblenden doppeltippen.</string>
    <string name="a11y_fav_on">Favorit: %1$s. Zum Entfernen doppeltippen.</string>
    <string name="a11y_fav_off">Kein Favorit: %1$s. Zum Hinzufügen doppeltippen.</string>
    <!-- Tag-Massenbearbeitung ("##tag"). %1$s = App-Name, %2$s = Tag. -->
    <string name="a11y_tag_on">Mit %2$s getaggt: %1$s. Zum Entfernen doppeltippen.</string>
    <string name="a11y_tag_off">Nicht mit %2$s getaggt: %1$s. Zum Hinzufügen doppeltippen.</string>
    <!-- Favoriten-Sortiermodus (die »-Aufnahme-Markierung wird nicht sinnvoll vorgelesen). -->
    <string name="a11y_reorder_pick">%1$s. Zum Aufnehmen doppeltippen.</string>
    <string name="a11y_reorder_picked">Aufgenommen: %1$s. Zum Abbrechen doppeltippen.</string>
    <string name="a11y_reorder_drop">%1$s. Zum Hierher-Verschieben doppeltippen.</string>

    <!-- Was eine leere App-Liste sagt (LauncherLogic.emptyHint). -->
    <string name="empty_no_match">Keine App passt</string>
    <string name="empty_no_apps">Keine Apps</string>
    <string name="empty_no_tags">Noch keine Tags — anlegen mit ##name</string>
    <string name="empty_no_tag_match">Kein Tag beginnt so</string>
    <string name="empty_no_favorites">Noch keine Favoriten — mit ! hinzufügen</string>
    <string name="empty_no_recents">Noch keine zuletzt genutzten Apps (leer nach Neustart)</string>
    <string name="empty_no_command">Kein solcher Befehl — ~ zeigt alle</string>
