    <string name="a11y_pane_drawer">Alle Apps</string>
    <string name="a11y_pane_recents">Zuletzt verwendet</string>
    <!-- Der Hinweis der Kommandozeile, wie ein Screenreader ihn spricht (der sichtbare beginnt mit ">"). -->
    <string name="a11y_prompt_hint">Alle Apps durchsuchen</string>
