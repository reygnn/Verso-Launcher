<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- app_name ist "Verso Launcher" (Marke) — kein -de-Override, fällt auf default zurück. -->
    <string name="hint_search">&gt; suche</string>
    <string name="clear_prompt">Eingabe löschen</string>
    <!-- Startseite (Vorderseite; der Drawer ist die Rückseite). -->
    <string name="home_hint">Nach oben wischen für alle Apps, nach unten für die zuletzt genutzten.\n\nDeine Favoriten kommen aus einer Config-Datei von dir: in einem beliebigen Editor anlegen (fav Gmail, eine App je Zeile), vom PC nach Android/data/com.github.reygnn.verso_launcher/files/config.txt kopieren und in der App-Liste ~restart eingeben.</string>
    <string name="a11y_home">Startbildschirm</string>
    <string name="a11y_open_drawer">Alle Apps öffnen</string>
    <string name="a11y_open_recents">Zuletzt verwendete Apps öffnen</string>
