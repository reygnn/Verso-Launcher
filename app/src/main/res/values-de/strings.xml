    <string name="a11y_battery_charging">Akku %1$s, lädt</string>
    <string name="a11y_battery_protected">Akku %1$s, Akkuschutz: Ladung wird gehalten</string>
    <string name="toast_no_app">Keine passende App auf diesem Gerät</string>
    <string name="toast_not_found">Nicht gefunden: %1$s</string>
    <string name="toast_denied">Verweigert: %1$s</string>
    <string name="toast_not_default_home">Für Arbeits-Apps Verso als Standard-Startseite festlegen</string>
    <!-- Die Config-Datei (~new, ~open, ~edit) und ihr Lesen. -->
    <string name="toast_config_unreadable">verso.json nicht lesbar — nichts davon wird gezeigt, die Datei bleibt, wie sie ist; ~open verknüpft eine Config-Datei</string>
    <string name="toast_config_file_unreadable">Config-Datei nicht lesbar — es gilt die zuletzt gelesene; ~open verknüpft sie neu</string>
    <string name="toast_open_unreadable">Diese Datei ist nicht lesbar — nichts geändert</string>
    <string name="toast_not_a_config">Keine Verso-Config — nichts geändert</string>
    <string name="toast_link_failed">Verso bekommt keinen dauerhaften Zugriff auf die Datei — anderen Ort versuchen</string>
    <string name="toast_linked">Config-Datei verknüpft — ~edit öffnet sie</string>
    <string name="toast_new_ok">Config-Datei angelegt — ~edit öffnet sie</string>
    <string name="toast_new_failed">Config-Datei nicht angelegt — anderen Ort versuchen</string>
